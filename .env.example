# Entorno HematoFlow
# Copia este archivo a .env y completa los valores

# ── Base de datos (Postgres local, ver README) ─────────
DATABASE_URL="postgresql://pausa:pausa_dev_2026@localhost:5433/hemato_flow?schema=public"


# ── Telegram (opcional, canal preferido) ───────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ENABLED=false
TELEGRAM_POLLING=true
TELEGRAM_SECRET_TOKEN=""

# ── Cifrado reversible de números ──────────────────────
# AES-256-GCM, 32 bytes en base64. Generar: bun -e "console.log(Buffer.from(require('crypto').randomBytes(32)).toString('base64'))"
AES_KEY=""
AES_SALT="pausa-ai-static-salt-2026"

# ── Auth (RBAC) ────────────────────────────────────────
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# ── Credenciales de seed (usuarios del panel) ──────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
MEDICO_USERNAME="medico"
MEDICO_PASSWORD=""
SOCIAL_USERNAME="social"
SOCIAL_PASSWORD=""
ENFERMERO_USERNAME="enfermero"
ENFERMERO_PASSWORD=""
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_PASSWORD=""

# ── Entorno ────────────────────────────────────────────
NODE_ENV="development"
PORT=3100
WEB_APP_PORT=3002
API_BASE_URL="http://localhost:3100"
